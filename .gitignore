# Python cache
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
venv/
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/

# Claude AI settings
.claude/

# PyInstaller build artifacts
build/
dist/

# Release archives and bundled instruction (go to GitHub Releases, not repo)
*.zip
Инструкция.html

# Auto-generated patched fonts
Fonts/*_patch.ttf

# Unused / extra files in Fonts
Fonts/AlphaDG.pdf
Fonts/!Chess fonts.doc
Fonts/Fonts-org/

# PGN/PDF test/user files in root. Example/ is shipped; the reference folder of
# character maps is cited by the docs, so its PDFs are tracked.
*.pgn
!Example/*.pgn
*.pdf
!Example/*.pdf
!Caractere do Diagrama/*.pdf

# Fonts recovered from PDFs, and the PDFs they were recovered from. A subset
# extracted from a PDF is the typeface, and so is the file carrying it, so none
# of this is distributed: what is versioned is the method — build_alphadg.py,
# Fonts-recovered/README.md and the release notes that describe each recovery.
Fonts/AlphaDG.ttf
Fonts/ZurichFigurine.TTF
Fonts/LinaresFigurine.TTF
Fonts-recovered/*.ttf
Fonts-recovered/*.TTF
Fonts-recovered/source-pdfs/
fonts_6a7de6c2db0e9/

# Documents written by hand while checking output.
# test.fen stays: output_snapshot.py reads it as input.
/review_smoke.*
/test.epub
/test.html
/tmp_*

# Generated by the test/verification scripts
smoke_out/
test_batch_out/
snapshot_out/

# Internal project docs (not for public repo)
ROADMAP.md
CLAUDE.md

# OS
.DS_Store
Thumbs.db
desktop.ini
