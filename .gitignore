# Python cache
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
venv/
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/

# Claude AI settings
.claude/

# PyInstaller build artifacts
build/
dist/

# Release archives and bundled instruction (go to GitHub Releases, not repo)
*.zip
Инструкция.html

# Auto-generated patched fonts
Fonts/*_patch.ttf

# Generated by build_alphadg.py from the copies in Fonts-recovered/. Not
# distributed as a font file: run the script to get it.
Fonts/AlphaDG.ttf

# Unused / extra files in Fonts
Fonts/AlphaDG.pdf
Fonts/!Chess fonts.doc
Fonts/Fonts-org/

# PGN/PDF test/user files in root. Example/ is shipped; two reference folders
# are cited by README, CHANGELOG and SPEC, so their PDFs are tracked too.
*.pgn
!Example/*.pgn
*.pdf
!Example/*.pdf
!fonts_6a7de6c2db0e9/*.pdf
!Caractere do Diagrama/*.pdf

# The material AlphaDG is rebuilt from: the 2011 PDFs that carry it embedded and
# the subsets extracted from them. Kept out of the repository on purpose — the
# recipe (build_alphadg.py) and the reasoning (Fonts-recovered/README.md) are
# versioned, the font outlines are not.
Fonts-recovered/*.ttf
Fonts-recovered/*.TTF
Fonts-recovered/source-pdfs/

# Documents written by hand while checking output.
# test.fen stays: output_snapshot.py reads it as input.
/review_smoke.*
/test.epub
/test.html
/tmp_*

# Generated by the test/verification scripts
smoke_out/
test_batch_out/
snapshot_out/

# Internal project docs (not for public repo)
ROADMAP.md
CLAUDE.md

# OS
.DS_Store
Thumbs.db
desktop.ini
